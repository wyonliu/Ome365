#!/usr/bin/env python3
"""
Ome365 · 极简一键启动

用法：
    ./ome365              # 首跑自动装依赖 + 起服务 + 开浏览器
    ./ome365 --port 8080  # 换端口
    ./ome365 --no-open    # 不开浏览器（SSH/无头环境）
    ./ome365 --setup      # 强制跑一次初始化（装依赖、复制 .env、hooks）
    ./ome365 setup        # 进入完整向导（family/demo/enterprise 场景）
    ./ome365 doctor       # 自检：依赖、端口、tenant_config

首跑等同于 `./setup.sh --mode solo --non-interactive`：
单人自用、无认证、vault=项目根。要换成 family/demo/enterprise 再跑 `./setup.sh`。
"""
from __future__ import annotations

import argparse
import os
import shutil
import signal
import socket
import subprocess
import sys
import time
import webbrowser
from pathlib import Path

ROOT = Path(__file__).resolve().parent
APP = ROOT / ".app"
SERVER = APP / "server.py"
REQUIREMENTS = ROOT / "requirements.txt"
ENV_EXAMPLE = ROOT / ".env.example"
ENV_FILE = ROOT / ".env"
MARKER = ROOT / ".ome365-bootstrapped"


# ── 小工具 ───────────────────────────────────
def say(msg: str) -> None:
    print(f"\033[36m[ome365]\033[0m {msg}", flush=True)


def warn(msg: str) -> None:
    print(f"\033[33m[warn]\033[0m {msg}", flush=True)


def die(msg: str, code: int = 1) -> None:
    print(f"\033[31m[fail]\033[0m {msg}", flush=True)
    sys.exit(code)


def port_is_free(port: int) -> bool:
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    # SO_REUSEADDR：忽略 BSD/macOS 上 TIME_WAIT 残留（uvicorn 自己也这样 bind）
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        s.bind(("127.0.0.1", port))
        return True
    except OSError:
        return False
    finally:
        s.close()


def wait_for_port(port: int, timeout: float = 20.0) -> bool:
    deadline = time.time() + timeout
    while time.time() < deadline:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(0.3)
        try:
            s.connect(("127.0.0.1", port))
            return True
        except Exception:
            time.sleep(0.2)
        finally:
            s.close()
    return False


# ── 依赖检查 ─────────────────────────────────
CORE_PKGS = ("fastapi", "uvicorn", "yaml", "requests", "jwt")


def missing_core_pkgs() -> list[str]:
    missing = []
    for name in CORE_PKGS:
        try:
            __import__(name)
        except ImportError:
            missing.append(name)
    return missing


def install_deps(quiet: bool = True) -> None:
    if not REQUIREMENTS.exists():
        warn("requirements.txt 缺失，跳过依赖安装")
        return
    say("装 Python 依赖（pip install -r requirements.txt）...")
    cmd = [sys.executable, "-m", "pip", "install", "-r", str(REQUIREMENTS)]
    if quiet:
        cmd.insert(4, "-q")
    r = subprocess.run(cmd, cwd=str(ROOT))
    if r.returncode != 0:
        die("pip install 失败；手动跑：pip install -r requirements.txt")


# ── 首跑 bootstrap ───────────────────────────
def bootstrap(force: bool = False) -> None:
    """首跑：装依赖 + 复制 .env + 启 git hooks。等价于 setup.sh --mode solo --non-interactive"""
    done_before = MARKER.exists() and not force

    # 依赖
    missing = missing_core_pkgs()
    if missing or force:
        if missing:
            say(f"缺依赖：{', '.join(missing)}")
        install_deps()

    # .env
    if not ENV_FILE.exists() and ENV_EXAMPLE.exists():
        shutil.copyfile(ENV_EXAMPLE, ENV_FILE)
        say(f"已复制 .env.example → .env")

    # git hooks（隐私守门员）
    if (ROOT / ".git").exists() and (ROOT / ".githooks").exists():
        try:
            subprocess.run(
                ["git", "config", "core.hooksPath", ".githooks"],
                cwd=str(ROOT), check=False, capture_output=True,
            )
        except Exception:
            pass

    # share_registry 兜底
    sr_live = APP / "share_registry.json"
    sr_sample = APP / "share_registry.sample.json"
    if not sr_live.exists() and sr_sample.exists():
        shutil.copyfile(sr_sample, sr_live)

    if not done_before:
        MARKER.write_text("ok\n", encoding="utf-8")
        say("首跑初始化完成（solo 模式：单人自用、无认证）")
        say("  - 要切成 family / demo / enterprise：跑 ./setup.sh")
        say("  - 要改 AI key：编辑 .env")


# ── 启动服务 ─────────────────────────────────
def run_server(port: int, open_browser: bool) -> int:
    if not SERVER.exists():
        die(f"找不到 {SERVER}；是不是不在 Ome365 项目根目录？")

    if not port_is_free(port):
        warn(f"端口 {port} 已被占用")
        warn(f"  查占用：lsof -ti:{port}")
        warn(f"  换端口：./ome365 --port 8080")
        return 2

    env = os.environ.copy()
    env["OME365_PORT"] = str(port)
    # http://localhost 下 Secure cookie 会被浏览器吞掉，dev 默认关
    env.setdefault("OME365_COOKIE_SECURE", "0")

    say(f"启动 server.py（port={port}）...")
    proc = subprocess.Popen(
        [sys.executable, str(SERVER)],
        cwd=str(APP), env=env,
    )

    try:
        if wait_for_port(port, timeout=20):
            url = f"http://localhost:{port}"
            say(f"已就绪 → {url}")
            if open_browser:
                try:
                    webbrowser.open(url)
                except Exception:
                    pass
            say("按 Ctrl-C 停止")
        else:
            warn("server 20s 内未响应；看上面日志")

        # 等 server 进程退出 / 用户 Ctrl-C
        return proc.wait()
    except KeyboardInterrupt:
        say("收到 Ctrl-C，关停 server...")
        try:
            proc.terminate()
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
        return 0


# ── 子命令：doctor 自检 ─────────────────────
def cmd_doctor_json() -> int:
    """JSON output for ops integration · machine-readable doctor result."""
    import json as _json
    import platform as _platform
    out = {
        "platform": _platform.system(),
        "python_version": sys.version.split()[0],
        "missing_core_pkgs": missing_core_pkgs(),
        "ports": {
            "3650_free": port_is_free(3650),
            "3651_free": port_is_free(3651),
        },
        "files": {
            "env_exists": ENV_FILE.exists(),
            "tenant_config_live": (APP / "tenant_config.json").exists(),
            "tenant_config_sample": (APP / "tenant_config.sample.json").exists(),
        },
        "v1_1_modules": {},
    }
    sys.path.insert(0, str(APP))
    for mod in [
        "ome365_eval", "ome365_decisions", "ome365_trace", "ome365_wiki",
        "ome365_archive", "ome365_backup", "ome365_audit", "ome365_metrics",
        "ome365_notify", "ome365_rbac", "ome365_signing", "ome365_cli_extras",
    ]:
        try:
            __import__(mod)
            out["v1_1_modules"][mod] = "ok"
        except Exception as e:
            out["v1_1_modules"][mod] = f"error: {e}"

    # Vault state
    vault = Path(os.environ.get("OME365_VAULT", ROOT)).resolve()
    if vault.exists():
        out["vault"] = {
            "path": str(vault),
            "decisions_count": len(list((vault / "Decisions").glob("*.md"))) if (vault / "Decisions").exists() else 0,
            "trace_files": sum(1 for _ in (vault / "Trace").glob("*.jsonl")) if (vault / "Trace").exists() else 0,
            "skills_count": len(list((vault / "Skills").glob("*.md"))) if (vault / "Skills").exists() else 0,
            "signing_key_present": (vault / ".ome365" / "keys" / "agent-card.ed25519").exists(),
            "rbac_present": (vault / ".ome365" / "roles.yml").exists(),
        }

    out["ok"] = (
        not out["missing_core_pkgs"]
        and all(v == "ok" for v in out["v1_1_modules"].values())
    )
    print(_json.dumps(out, indent=2, ensure_ascii=False))
    return 0 if out["ok"] else 1


def cmd_doctor() -> int:
    """Multi-platform diagnostic · checks 12 things across 4 dimensions."""
    if "--json" in sys.argv:
        return cmd_doctor_json()
    import platform as _platform
    ok = True
    warnings = []
    print("─" * 60)
    print(f"  Ome365 doctor · diagnostic 12 checks")
    print("─" * 60)

    # ── Dim 1: Platform & Python ──
    sys_name = _platform.system()
    is_wsl = False
    try:
        with open("/proc/version", "r") as f:
            is_wsl = "microsoft" in f.read().lower() or "wsl" in f.read().lower()
    except Exception:
        pass
    plat = "WSL" if is_wsl else sys_name
    print(f"  [1/12] Platform     : {plat} ({_platform.machine()})")
    print(f"  [2/12] Python       : {sys.version.split()[0]} ({sys.executable})")
    py_ver = sys.version_info
    if py_ver < (3, 9):
        print(f"          → \033[31m需 Python 3.9+\033[0m"); ok = False
    elif py_ver >= (3, 13):
        warnings.append("Python 3.13+ · 部分依赖可能未适配")

    # ── Dim 2: Core deps ──
    missing = missing_core_pkgs()
    if missing:
        print(f"  [3/12] Core deps    : \033[31m缺 {missing}\033[0m → 跑 ./ome365 --setup")
        ok = False
    else:
        print(f"  [3/12] Core deps    : \033[32m fastapi/uvicorn/yaml/pydantic 齐全\033[0m")

    # ── Optional but recommended deps ──
    optional_status = []
    for pkg, hint in [("httpx", "测试套件"), ("sentence_transformers", "本地 embedding"), ("cryptography", "share Fernet")]:
        try:
            __import__(pkg.replace("-", "_"))
            optional_status.append(f"\033[32m✓\033[0m {pkg}")
        except ImportError:
            optional_status.append(f"\033[33m○\033[0m {pkg} ({hint})")
    print(f"  [4/12] Optional     : {' · '.join(optional_status)}")

    # ── Dim 3: Config files ──
    if ENV_FILE.exists():
        print(f"  [5/12] .env         : \033[32m存在\033[0m")
    else:
        print(f"  [5/12] .env         : \033[33m缺失\033[0m（首跑自动复制）")

    tc_live = APP / "tenant_config.json"
    tc_sample = APP / "tenant_config.sample.json"
    if tc_live.exists():
        print(f"  [6/12] tenant_config: live · {tc_live.stat().st_size}B")
    elif tc_sample.exists():
        print(f"  [6/12] tenant_config: sample 兜底 · {tc_sample.stat().st_size}B（solo/demo OK）")
    else:
        print(f"  [6/12] tenant_config: \033[31m两个都缺\033[0m"); ok = False

    cc_sample = APP / "cockpit_config.sample.json"
    if cc_sample.exists():
        print(f"  [7/12] cockpit_config sample: \033[32m✓\033[0m")
    else:
        print(f"  [7/12] cockpit_config sample: \033[33m缺\033[0m")

    # ── Dim 4: Runtime ──
    port = int(os.environ.get("OME365_PORT", "3650"))
    if port_is_free(port):
        print(f"  [8/12] Port {port}    : \033[32m空闲\033[0m")
    else:
        print(f"  [8/12] Port {port}    : \033[33m被占\033[0m → lsof -ti:{port} | xargs kill")
        warnings.append(f"port {port} busy")

    share_port = int(os.environ.get("SHARE_PORT", "3651"))
    if port_is_free(share_port):
        print(f"  [9/12] Port {share_port}    : \033[32m空闲\033[0m (share_server)")
    else:
        print(f"  [9/12] Port {share_port}    : \033[33m被占\033[0m (share_server)")

    home = Path(os.environ.get("OME365_HOME", Path.home() / ".ome365"))
    tenants = home / "tenants"
    if tenants.exists():
        n = len([p for p in tenants.iterdir() if p.is_dir()])
        print(f"  [10/12] Multi-tenant: {n} 个 ({tenants})")
    else:
        print(f"  [10/12] Multi-tenant: 未启用（legacy 单用户·OK）")

    # ── Git status ──
    git_dir = ROOT / ".git"
    if git_dir.exists():
        try:
            head = subprocess.run(["git", "-C", str(ROOT), "rev-parse", "--short", "HEAD"],
                                  capture_output=True, text=True, timeout=5)
            branch = subprocess.run(["git", "-C", str(ROOT), "branch", "--show-current"],
                                    capture_output=True, text=True, timeout=5)
            print(f"  [11/12] Git         : {head.stdout.strip()} on {branch.stdout.strip() or 'detached'}")
        except Exception:
            print(f"  [11/12] Git         : \033[33mgit cmd failed\033[0m")
    else:
        print(f"  [11/12] Git         : not a git repo (downloaded zip OK)")

    # ── Disk space ──
    try:
        st = shutil.disk_usage(str(ROOT))
        free_gb = st.free / (1024**3)
        if free_gb < 1:
            print(f"  [12/12] Disk free   : \033[31m{free_gb:.1f} GB\033[0m → 至少 1 GB")
            ok = False
        elif free_gb < 5:
            print(f"  [12/12] Disk free   : \033[33m{free_gb:.1f} GB\033[0m (建议 ≥ 5 GB)")
        else:
            print(f"  [12/12] Disk free   : \033[32m{free_gb:.1f} GB\033[0m")
    except Exception:
        print(f"  [12/12] Disk free   : ?")

    # ── v1.1.x module checks ──────────────────────────────────────
    print()
    print("─" * 60)
    print(f"  v1.1 modules · 8-week build (Decisions/Trace/Eval/Wiki/Audit/...)")
    print("─" * 60)
    sys.path.insert(0, str(APP))

    v11_modules = [
        ("ome365_eval",       "Eval (7-dim · D1-D7)"),
        ("ome365_decisions",  "Decisions (8-step + Kevin hook)"),
        ("ome365_trace",      "Trace (jsonl + async)"),
        ("ome365_wiki",       "Wiki (Karpathy distill)"),
        ("ome365_archive",    "Archive (gzip 95/5)"),
        ("ome365_backup",     "Backup (tarball)"),
        ("ome365_audit",      "Audit (SOC2/ISO27001)"),
        ("ome365_metrics",    "Prometheus /metrics"),
        ("ome365_notify",     "Webhook notify"),
        ("ome365_rbac",       "RBAC (3 roles)"),
        ("ome365_signing",    "ed25519 agent-card"),
        ("ome365_cli_extras", "CLI extras (verify/status/eval)"),
    ]
    n_loaded = 0
    for mod, label in v11_modules:
        try:
            __import__(mod)
            print(f"  \033[32m✓\033[0m {label:<40}")
            n_loaded += 1
        except Exception as e:
            print(f"  \033[31m✗\033[0m {label:<40}  ({e})")
            ok = False

    # Optional dep status (informational · not failures)
    print()
    print("  optional deps (gated by env flag · OK if missing):")
    for pkg, hint in [
        ("anthropic", "P3 #15 LLM wiki · OME365_WIKI_LLM=1"),
        ("openai", "P3 #15 LLM wiki (alt) · OME365_WIKI_LLM=1"),
        ("sqlite_vec", "P3 #16 semantic search · OME365_WIKI_VEC=1"),
        ("sentence_transformers", "P3 #16 embedding model · OME365_WIKI_VEC=1"),
    ]:
        try:
            __import__(pkg.replace("-", "_"))
            print(f"    \033[32m✓\033[0m {pkg:<25} {hint}")
        except ImportError:
            print(f"    \033[33m○\033[0m {pkg:<25} {hint}")

    # Vault state (informational)
    vault = Path(os.environ.get("OME365_VAULT", ROOT)).resolve()
    if vault.exists():
        n_dec = len(list((vault / "Decisions").glob("*.md"))) if (vault / "Decisions").exists() else 0
        n_trace = sum(1 for _ in (vault / "Trace").glob("*.jsonl")) if (vault / "Trace").exists() else 0
        n_skill = len(list((vault / "Skills").glob("*.md"))) if (vault / "Skills").exists() else 0
        signing = (vault / ".ome365" / "keys" / "agent-card.ed25519").exists()
        roles = (vault / ".ome365" / "roles.yml").exists()
        green_check = "\033[32m✓\033[0m"
        yellow_dot = "\033[33m○\033[0m"
        signing_status = green_check if signing else (yellow_dot + " (auto-gen on first /.well-known/agent-card.json)")
        roles_status = (green_check + " present (RBAC enabled)") if roles else (yellow_dot + " (default-contributor mode)")
        print()
        print(f"  vault state ({vault.name}/):")
        print(f"    Decisions: {n_dec} files · Trace: {n_trace} jsonl · Skills: {n_skill}")
        print(f"    signing key: {signing_status}")
        print(f"    roles.yml:   {roles_status}")

    print("─" * 60)
    if ok and not warnings:
        print(f"  \033[32m✓ All green\033[0m · {n_loaded}/{len(v11_modules)} v1.1 modules loaded · 可启动 ./ome365")
    elif ok:
        print(f"  \033[33m! {len(warnings)} warnings\033[0m: {' · '.join(warnings)}")
    else:
        print(f"  \033[31m✗ Doctor failed\033[0m · 修上面 ✗ 项后再启动")
    print("─" * 60)
    return 0 if ok else 1


# ── publish CLI 派发 ────────────────────────
def _dispatch_publish(argv: list) -> int:
    """
    把 argv 转给 .app/publish/cli.py。

    做 subprocess 避免污染 launcher 自身的 sys.path；如果以后要 inline
    只需：from publish.cli import main; return main(argv)
    """
    app = APP
    if not (app / "publish" / "cli.py").exists():
        die("publish 模块缺失（.app/publish/cli.py）。是否拉到了最新版？")
    env = os.environ.copy()
    env.setdefault("PYTHONPATH", str(app))
    r = subprocess.run(
        [sys.executable, "-m", "publish.cli", *argv],
        cwd=str(app),
        env=env,
    )
    return r.returncode


# ── 主入口 ───────────────────────────────────
def main() -> int:
    # 支持两种用法：./ome365 [flags] | ./ome365 <subcommand>
    argv = sys.argv[1:]
    if argv and argv[0] in ("setup", "doctor", "help", "--help", "-h", "publish", "share", "trace", "wiki", "archive", "backup", "audit", "verify", "status", "eval", "metrics", "notify", "rbac"):
        sub = argv[0]
        if sub in ("help", "--help", "-h"):
            print(__doc__)
            return 0
        if sub == "setup":
            setup_sh = ROOT / "setup.sh"
            if not setup_sh.exists():
                die("setup.sh 缺失")
            os.execv("/bin/bash", ["bash", str(setup_sh), *argv[1:]])
        if sub == "doctor":
            return cmd_doctor()
        if sub == "trace":
            sys.path.insert(0, str(APP))
            from ome365_trace import cli_main as _trace_cli
            return _trace_cli(argv[1:])
        if sub == "wiki":
            sys.path.insert(0, str(APP))
            from ome365_wiki import cli_main as _wiki_cli
            return _wiki_cli(argv[1:])
        if sub == "archive":
            sys.path.insert(0, str(APP))
            from ome365_archive import cli_main as _arch_cli
            return _arch_cli(argv[1:])
        if sub == "backup":
            sys.path.insert(0, str(APP))
            from ome365_backup import cli_main as _backup_cli
            return _backup_cli(argv[1:])
        if sub == "audit":
            sys.path.insert(0, str(APP))
            from ome365_audit import cli_main as _audit_cli
            return _audit_cli(argv[1:])
        if sub == "metrics":
            sys.path.insert(0, str(APP))
            from ome365_metrics import cli_main as _metrics_cli
            return _metrics_cli(argv[1:])
        if sub == "notify":
            sys.path.insert(0, str(APP))
            from ome365_notify import cli_main as _notify_cli
            return _notify_cli(argv[1:])
        if sub == "rbac":
            sys.path.insert(0, str(APP))
            from ome365_rbac import cli_main as _rbac_cli
            return _rbac_cli(argv[1:])
        if sub == "verify":
            sys.path.insert(0, str(APP))
            from ome365_cli_extras import cmd_verify
            return cmd_verify(argv[1:])
        if sub == "status":
            sys.path.insert(0, str(APP))
            from ome365_cli_extras import cmd_status
            return cmd_status(argv[1:])
        if sub == "eval":
            sys.path.insert(0, str(APP))
            from ome365_cli_extras import cmd_eval
            return cmd_eval(argv[1:])
        if sub == "publish":
            # 派发到 publish.cli 的 publish 子命令
            return _dispatch_publish(["publish", *argv[1:]])
        if sub == "share":
            # share list / share revoke / share policies → 直接透传给 publish.cli
            if len(argv) < 2:
                print(
                    "用法：\n"
                    "  ./ome365 share list [--all]           列出快照\n"
                    "  ./ome365 share revoke <snapshot-id>   撤销快照\n"
                    "  ./ome365 share policies               显示 policy 列表"
                )
                return 2
            return _dispatch_publish(argv[1:])

    p = argparse.ArgumentParser(
        prog="ome365",
        description="Ome365 极简启动器：首跑自动装依赖、起服务、开浏览器。",
    )
    p.add_argument("--port", type=int, default=int(os.environ.get("OME365_PORT", "3650")),
                   help="服务端口（默认 3650 或 env OME365_PORT）")
    p.add_argument("--no-open", action="store_true", help="不自动打开浏览器")
    p.add_argument("--setup", action="store_true", help="强制跑一次 bootstrap（装依赖 / 复制 .env / 装 git hooks）")
    p.add_argument("--no-bootstrap", action="store_true", help="跳过 bootstrap（已装好了只想起服务）")
    args = p.parse_args(argv)

    if args.setup:
        bootstrap(force=True)
        return 0

    if not args.no_bootstrap:
        if not MARKER.exists() or missing_core_pkgs():
            bootstrap(force=False)

    return run_server(args.port, open_browser=not args.no_open)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
